@model IEnumerable<SalesWebMvc.Models.SalesRecord>

@{
    ViewData["Title"] = "Sales Records";
}

<h2>@ViewData["Title"]</h2>

<hr />

<table class="table table-striped table-hover table-bordered">

    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Seller</th>
            <th>Department</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>

                    <td>
                        @(item.Date.ToString("MM/dd/yyyy"))
                    </td>

                    <td>
                        @item.Amount.ToString("F2")
                    </td>

                    <td>
                        @item.Status
                    </td>

                    <td>
                        @item.Seller?.Name
                    </td>

                    <td>
                        @item.Seller?.Department?.Name
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-danger">
                    No records found
                </td>
            </tr>
        }
    </tbody>

</table>