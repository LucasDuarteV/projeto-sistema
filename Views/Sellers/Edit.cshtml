@model SalesWebMvc.Models.ViewModels.SellerFormViewModel

@{
    ViewData["Title"] = "Edit Seller";
}

<div class="container mt-4">

    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Edit Seller
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit">
                <input type="hidden" asp-for="Seller.Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Seller.Name" class="form-label fw-bold"></label>
                    <input asp-for="Seller.Name" class="form-control" />
                    <span asp-validation-for="Seller.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Seller.Email" class="form-label fw-bold"></label>
                    <input asp-for="Seller.Email" class="form-control" />
                    <span asp-validation-for="Seller.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Seller.BirthDate" class="form-label fw-bold"></label>
                    <input asp-for="Seller.BirthDate" class="form-control" type="date" />
                    <span asp-validation-for="Seller.BirthDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Seller.BaseSalary" class="form-label fw-bold"></label>
                    <input asp-for="Seller.BaseSalary" class="form-control" />
                    <span asp-validation-for="Seller.BaseSalary" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Seller.DepartmentId" class="form-label fw-bold"></label>
                    <select asp-for="Seller.DepartmentId"
                            asp-items="@(new SelectList(Model.Departments, "Id", "Name"))"
                            class="form-select">
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i>
                        Save
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}