@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">Sales Web MVC</h1>
        <p class="lead text-muted">
            Sistema de gerenciamento de vendedores, departamentos e registros de vendas.
        </p>
    </div>

    <div class="row justify-content-center">

        <div class="col-md-4 mb-4">
            <div class="card shadow-lg h-100">
                <div class="card-body text-center">
                    <h3>👨‍💼 Vendedores</h3>
                    <p>Gerencie os vendedores cadastrados no sistema.</p>
                    <a asp-controller="Sellers" asp-action="Index" class="btn btn-primary">
                        Acessar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-lg h-100">
                <div class="card-body text-center">
                    <h3>🏢 Departamentos</h3>
                    <p>Visualize e administre os departamentos.</p>
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-success">
                        Acessar
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-5">
        <p class="text-muted">
            Desenvolvido com ASP.NET Core MVC, Entity Framework Core e MySQL.
        </p>
    </div>

</div>